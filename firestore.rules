rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'lastLoginAt']) &&
             data.keys().size() >= 3 && data.keys().size() <= 6 &&
             data.email is string && data.email.size() <= 100 &&
             data.createdAt == request.time &&
             data.lastLoginAt == request.time &&
             (data.keys().hasAny(['displayName']) ? (data.displayName is string && data.displayName.size() <= 100) : true) &&
             (data.keys().hasAny(['photoURL']) ? (data.photoURL is string && data.photoURL.size() <= 2048) : true) &&
             (data.keys().hasAny(['role']) ? (data.role is string && data.role.size() <= 20) : true);
    }

    match /users/{userId} {
      allow read: if request.auth != null && isValidId(userId) && request.auth.uid == userId;
      allow create: if request.auth != null && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if request.auth != null && isValidId(userId) && request.auth.uid == userId &&
                    incoming().lastLoginAt == request.time &&
                    incoming().email == existing().email &&
                    incoming().createdAt == existing().createdAt &&
                    (
                      incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginAt']) ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginAt', 'displayName', 'photoURL'])
                    );
    }
  }
}
